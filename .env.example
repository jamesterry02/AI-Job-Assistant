# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# --- General ---
ENVIRONMENT=development

# --- Database ---
# Local docker-compose Postgres+pgvector connection string
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/job_copilot

# --- Auth ---
JWT_SECRET=change-me-in-development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Storage ---
# local | azure
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./backend/storage

# Only required when STORAGE_PROVIDER=azure
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_CONNECTION_STRING=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
